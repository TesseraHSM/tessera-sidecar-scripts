#
# Non-SNP variant: the same MSHV platform without memory encryption, so
# none of the SEV-SNP specific boot, console or DMA paths are built in.

CONFIG_UK_NAME="ddi_sock_server-mshv-unikraft-nosnp"

#
# Platform: MSHV, booted through the Linux boot protocol.
#
CONFIG_PLAT_MSHV=y
CONFIG_MSHV_BOOT_PROTO_LXBOOT=y
CONFIG_MSHV_SYNIC=y
# CONFIG_MSHV_IGVM_MEMMAP is not set

# CONFIG_X86_SNP_VC_EARLY is not set
# CONFIG_X86_SNP_EARLY_CON is not set
# CONFIG_LIBVIRTIO_SNP_DMA is not set
# CONFIG_MSHV_SNP_RESTRICTED_INJECTION is not set

# X86_SNP_MMIO_MAPPED is deliberately left alone. LIBVIRTIO_PCI_MODERN
# selects it whenever the platform can serve confidential MMIO, which
# plat/mshv always can, so it stays on here too. The code it adds only ever
# runs from the #VC handler and is therefore inert on a guest that is not
# running under SEV-SNP.
