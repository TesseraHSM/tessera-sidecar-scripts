#
# Options shared by every ddi_sock_server unikernel variant.
#
# The application is an unmodified Linux ELF binary, so the unikernel is built
# from app-elfloader: Unikraft provides the syscall surface and the ELF loader
# execs the binary out of an embedded initrd.

CONFIG_ARCH_X86_64=y

#
# The platform and boot protocol are selected per variant, since they are the
# only thing that genuinely differs between the targets.
#
CONFIG_OPTIMIZE_PIE=y
CONFIG_UKPLAT_MEMREGION_MAX_COUNT=512
CONFIG_STACK_SIZE_PAGE_ORDER=8

#
# Console
#
CONFIG_LIBUKCONSOLE=y
CONFIG_LIBNS16550=y
CONFIG_LIBNS16550_EARLY_CONSOLE=y
CONFIG_LIBUKPRINT_KLVL_INFO=y

#
# Core libraries
#
CONFIG_LIBUKBOOT_MAINTHREAD=y
CONFIG_LIBUKBUS=y
CONFIG_LIBUKSGLIST=y
CONFIG_LIBUKALLOCBBUDDY=y
CONFIG_LIBUKPAGING=y
CONFIG_LIBUKVMEM=y

#
# POSIX surface required by a glibc/tokio application
#
CONFIG_LIBSYSCALL_SHIM=y
CONFIG_LIBSYSCALL_SHIM_HANDLER=y
CONFIG_LIBPOSIX_ENVIRON=y
CONFIG_LIBPOSIX_FUTEX=y
CONFIG_LIBPOSIX_MMAP=y
CONFIG_LIBPOSIX_PROCESS=y
CONFIG_LIBPOSIX_PROCESS_MULTITHREADING=y
CONFIG_LIBPOSIX_PROCESS_MAX_PID=127
CONFIG_LIBPOSIX_PROCESS_BRK=y
CONFIG_LIBPOSIX_PROCESS_ARCH_PRCTL=y
CONFIG_LIBPOSIX_PROCESS_SIGNAL=y
CONFIG_LIBPOSIX_PROCESS_CLONE_PREFER_CHILD=y
CONFIG_LIBPOSIX_POLL=y
CONFIG_LIBPOSIX_POLL_YIELD=y
CONFIG_LIBPOSIX_EVENTFD=y
CONFIG_LIBPOSIX_SYSINFO=y
CONFIG_LIBPOSIX_TIME=y
CONFIG_LIBPOSIX_TTY=y
CONFIG_LIBPOSIX_USER=y

#
# Filesystem: the application and its shared libraries are delivered in an
# initrd that is linked into the kernel image and mounted as /.
#
CONFIG_LIBVFSCORE=y
CONFIG_LIBVFSCORE_AUTOMOUNT_CI=y
CONFIG_LIBVFSCORE_AUTOMOUNT_CI_EINITRD=y
CONFIG_LIBRAMFS=y
CONFIG_LIBDEVFS=y
CONFIG_LIBDEVFS_AUTOMOUNT=y

#
# Randomness: Rust's std and OpenSSL both want getrandom(2) and /dev/urandom.
#
CONFIG_LIBUKRANDOM=y
CONFIG_LIBUKRANDOM_LCPU=y
CONFIG_LIBUKRANDOM_GETRANDOM=y
CONFIG_LIBUKRANDOM_DEVFS=y
# CONFIG_LIBUKRANDOM_CMDLINE_SEED is not set

#
# Transport: AF_VSOCK over virtio-vsock on a modern virtio PCI device.
#
# LIBVIRTIO_PCI_MODERN discovers the device through ACPI MCFG and delivers
# completions over MSI-X. On an SNP guest it also selects X86_SNP_MMIO_MAPPED
# so that BAR accesses made with ordinary loads and stores are serviced.
#
CONFIG_LIBPOSIX_SOCKET=y
CONFIG_LIBUKVSOCKDEV=y
CONFIG_LIBVIRTIO_VSOCK=y
CONFIG_LIBVIRTIO_PCI_MODERN=y

#
# Disable the legacy virtio PCI transport. drivers/virtio/bus/Config.uk has
# "imply LIBVIRTIO_PCI if HAVE_PCI", so it would otherwise be on by default,
# and both transports register a PCI driver matching 1af4:1053. The bus binds
# the first match and does not fall through, so the legacy driver wins and
# rejects the device ("Invalid Virtio Devices 1053") -- virtio-vsock is a
# virtio 1.0 only device and has no transitional ID the legacy code can drive.
#
# CONFIG_LIBVIRTIO_PCI is not set
CONFIG_LIBUKACPI=y
CONFIG_LIBUKINTCTLR_APIC=y

# ukvsockdev includes <uk/netbuf.h> but does not select the library that
# provides it, so uknetdev has to be enabled explicitly even though no network
# device is ever attached.
CONFIG_LIBUKNETDEV=y

#
# No network stack: the application speaks vsock only.
#
# CONFIG_LIBLWIP is not set

#
# Application: app-elfloader
#
CONFIG_APPELFLOADER_VFSEXEC=y
# CONFIG_APPELFLOADER_CUSTOMAPPNAME is not set
CONFIG_APPELFLOADER_VFSEXEC_PATH="/ddi_sock_server"
CONFIG_APPELFLOADER_STACK_NBPAGES=256
# CONFIG_APPELFLOADER_DEBUG is not set
# CONFIG_LIBSYSCALL_SHIM_STRACE is not set

#
# Environment handed to the application.
#
# The initrd carries no ld.so.cache, so the dynamic loader falls back to its
# built-in search path. LD_LIBRARY_PATH states explicitly where the shared
# libraries were staged, which keeps the initrd working regardless of how the
# build host's glibc was configured.
#
CONFIG_LIBPOSIX_ENVIRON_ENVP0="PATH=/"
CONFIG_LIBPOSIX_ENVIRON_ENVP1="HOME=/tmp"
CONFIG_LIBPOSIX_ENVIRON_ENVP2="TMPDIR=/tmp"
CONFIG_LIBPOSIX_ENVIRON_ENVP3="RUST_BACKTRACE=1"
CONFIG_LIBPOSIX_ENVIRON_ENVP4="OPENSSL_CONF=/etc/ssl/openssl.cnf"
CONFIG_LIBPOSIX_ENVIRON_ENVP5="LD_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu:/lib/x86_64-linux-gnu:/lib64:/lib"
