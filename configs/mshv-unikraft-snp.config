#
# SNP variant: the guest runs directly in VTL0 under AMD SEV-SNP with no
# paravisor, so it has to service its own #VC exceptions and keep guest
# memory private from the host.
CONFIG_UK_NAME="ddi_sock_server-mshv-unikraft-snp"

#
# Platform: MSHV, booted through the Linux boot protocol.
#
# MSHV hands the kernel a lxboot (Linux x86 boot protocol) entry, and the
# memory map comes from that boot protocol rather than from an IGVM parameter
# area.
#
CONFIG_PLAT_MSHV=y
CONFIG_MSHV_BOOT_PROTO_LXBOOT=y
CONFIG_MSHV_SYNIC=y
# CONFIG_MSHV_IGVM_MEMMAP is not set

# Handle the #VC exceptions raised by early-boot CPUID over the GHCB MSR
# protocol, before any allocator or shared page exists.
CONFIG_X86_SNP_VC_EARLY=y

# Required to boot. MSHV refuses to create an SNP partition that does not use
# restricted injection, and this symbol is what establishes the GHCB page.
# Without it the #VC handler cannot emulate the ECAM and BAR accesses the
# virtio-pci driver makes, so boot stalls after "Probe buses...". The GHCB MSR
# protocol still works, which is why early CPUID #VCs succeed regardless.
CONFIG_MSHV_SNP_RESTRICTED_INJECTION=y

# Drive COM1 through the GHCB so that a failure before the real console comes
# up is still reported. Without a paravisor there is no VTL2 error page.
CONFIG_X86_SNP_EARLY_CON=y

# Keep virtqueue ownership and payloads private, exposing only shared ring
# pages and a bounded bounce pool to the host.
CONFIG_LIBVIRTIO_SNP_DMA=y
