#
# KVM variant: a plain, unencrypted guest on QEMU/KVM.
#
# Note on Cloud Hypervisor: it direct-boots only an ELF carrying a PVH note or
# a bzImage. This Unikraft tree emits neither on x86_64 (plat/kvm has no PVH
# entry point, and support/scripts/mklinux.py is ARM64 only), so Cloud
# Hypervisor is not a supported target for this variant. Booting it there
# would need either a PVH entry added to plat/kvm, or UEFI firmware
# (CLOUDHV.fd) plus the EFI stub boot protocol and an EFI system partition.

CONFIG_UK_NAME="ddi_sock_server-kvm-unikraft-nosnp"

#
# Platform: KVM with QEMU as the host.
#
# The QEMU selection is what brings in HAVE_PCI, which the modern virtio
# PCI transport depends on. The Firecracker selection does not, and on x86_64
# it is also the only way to reach KVM_BOOT_PROTO_LXBOOT, so it cannot be used
# for a vsock-over-PCI guest.
#
CONFIG_PLAT_KVM=y
CONFIG_KVM_VMM_QEMU=y
CONFIG_KVM_BOOT_PROTO_MULTIBOOT=y

#
# Override the static-PIE default from common.config: it is broken for the
# multiboot entry in this tree.
#
# plat/kvm/x86/multiboot.S hardcodes the runtime load base as 0x00100000 before
# calling do_uk_reloc32, but plat/common/x86/link64.lds.S links at BASE_ADDR
# 0x400000 (this tree retargeted it for the MSHV lxboot entry). QEMU honours
# the ELF program headers and loads at 0x400000, so the self-relocation runs
# against a base that is 3 MiB off and the kernel jumps into garbage.
#
# Without LIBUKRELOC the ur_mov and do_uk_reloc32 macros degrade to plain
# absolute movs, so the image simply runs at its link address and boots. The
# MSHV variants keep PIE, where the lxboot entry derives the base correctly.
#
# CONFIG_OPTIMIZE_PIE is not set
# CONFIG_LIBUKRELOC is not set

#
# No memory encryption, so none of the SEV-SNP paths are built in. Unlike the
# MSHV variants, nothing force-selects X86_SNP_MMIO_MAPPED here: it is
# selected only when the platform can serve confidential MMIO, which plat/kvm
# cannot.
#
# CONFIG_X86_SNP_VC_EARLY is not set
# CONFIG_X86_SNP_EARLY_CON is not set
# CONFIG_X86_SNP_MMIO_MAPPED is not set
# CONFIG_LIBVIRTIO_SNP_DMA is not set
