#
# Minimal x86_64 Linux kernel for the kvm-linux-nosnp variant: enough to boot an
# initramfs under QEMU/KVM and run a tokio + OpenSSL server that talks
# AF_VSOCK, and deliberately nothing else. Merged onto tinyconfig, so every
# option here is one this image actually needs.

CONFIG_64BIT=y
CONFIG_SMP=y

#
# Syscall surface the application depends on.
#
# tokio's reactor is epoll plus eventfd and timerfd; Rust's std synchronisation
# primitives are futexes. A kernel missing any of these links and boots, then
# hangs or aborts the moment the runtime starts.
#
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_TIMERFD=y
CONFIG_SIGNALFD=y
CONFIG_FUTEX=y
CONFIG_POSIX_TIMERS=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_MULTIUSER=y
CONFIG_SHMEM=y
CONFIG_BINFMT_ELF=y

#
# Boot: the root filesystem is the initramfs the build stages, nothing else.
#
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

#
# Console. QEMU's -nographic wires COM1 to stdio, and the kernel command line
# names ttyS0.
#
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

#
# Transport: virtio-vsock over MMIO.
#
# The target is QEMU's microvm machine, which has no PCI bus and no ACPI, so
# neither is built. That is worth more than it sounds: PCI is what made the
# uncore performance counters and VGA arbitration 'default y', and ACPI is what
# dragged in PNP, the processor driver, the thermal layer and cpuidle. Turning
# the two of them off removes all of that without naming any of it.
#
# Without ACPI there is no device tree to enumerate, so QEMU describes the MMIO
# devices on the kernel command line instead -- it appends the virtio_mmio.device
# arguments itself, which is what CMDLINE_DEVICES exists to parse.
#
# CONFIG_PCI is not set
# CONFIG_ACPI is not set
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_NET=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y

#
# Direct ELF boot. PVH lets the loader enter the kernel at its 32-bit entry
# point with a prepared boot structure, so the real-mode setup code and the
# self-decompression stub that bzImage carries are both skipped. The symbol
# lives inside "if HYPERVISOR_GUEST", so enabling it needs both.
#
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PVH=y

#
# kvmclock. microvm has no PIT, no HPET and no ACPI PM timer, so there is
# nothing for the TSC to be calibrated against and the boot stalls at "Marking
# TSC unstable". A paravirtual clock read straight from the host needs no
# calibration at all. This is not optional.
#
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_PARAVIRT_CLOCK=y

#
# Keyboard, mouse and virtual terminals, off.
#
# All of this is 'default y' and arrives uninvited: VT selects INPUT, INPUT
# pulls in the keyboard and mouse drivers, and SERIO_I8042 probes for a PS/2
# controller. The console here is a serial port and the only input this guest
# ever receives is a vsock packet, so none of it is reachable.
#
# CONFIG_VT is not set
# CONFIG_INPUT is not set
# CONFIG_SERIO is not set

#
# CPU power management, off.
#
# SCHED_MC_PRIO is the root of this: it is 'default y' and selects
# X86_INTEL_PSTATE and CPU_FREQ. Disabling the leaves alone does not work --
# they are selected back on -- so the chain has to be cut at the top.
#
# Frequency and idle states belong to the host. A guest that tried to manage
# them would be acting on numbers it cannot affect.
#
# CONFIG_SCHED_MC_PRIO is not set
# CONFIG_X86_INTEL_PSTATE is not set
# CONFIG_CPU_FREQ is not set
